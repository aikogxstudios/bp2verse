---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Título de la página; por defecto, el genérico del sitio. */
  title?: string;
  /** Descripción meta; por defecto, la genérica del sitio. */
  description?: string;
  /** Ruta sin idioma para canonical/alternate (p. ej. '/playground'). */
  path?: string;
}

const { lang, title, description, path = '/' } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL(Astro.url.origin);
const alternate = (l: Lang) => new URL(localizedPath(l, path), site).href;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? t('meta.description')} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080b" />
    <title>{title ?? t('meta.title')}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={alternate(lang)} />
    <link rel="alternate" hreflang="es" href={alternate('es')} />
    <link rel="alternate" hreflang="en" href={alternate('en')} />
    <link rel="alternate" hreflang="x-default" href={alternate('es')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
